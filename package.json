{
  "name": "i18n-automatically",
  "displayName": "i18n-automatically",
  "description": "一键扫描中文、自动替换为 i18n Key，并即时生成/更新语言包（开箱即用，支持 Vue/React/TS/JS，内置免费翻译）",
  "publisher": "wu529778790",
  "author": "wu529778790",
  "repository": "https://github.com/wu529778790/i18n-automatically",
  "version": "1.2.0-beta.1",
  "engines": {
    "vscode": "^1.69.0"
  },
  "categories": [
    "Extension Packs",
    "Programming Languages",
    "Visualization",
    "Debuggers",
    "Notebooks"
  ],
  "keywords": [
    "i18n",
    "i18n Ally",
    "i18n ally",
    "i18n-ally",
    "vue i18n",
    "electron",
    "vue3 i18n",
    "react i18n",
    "shopify-i18n",
    "shopify",
    "i18next",
    "多语言",
    "多语言插件",
    "多语言翻译",
    "i18n插件",
    "i18n tool",
    "国际化",
    "国际化多语言",
    "自动翻译",
    "中文",
    "扫描",
    "翻译",
    "翻译插件",
    "i18n vue",
    "文案",
    "vue",
    "vue3",
    "react",
    "ali",
    "react-intl",
    "国际化 i18n",
    "poizon"
  ],
  "icon": "public/logo.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:extension.automatically.i18n.scanChinese",
    "onCommand:extension.automatically.i18n.scanChineseBatch",
    "onCommand:extension.automatically.i18n.generateLanguagePackage",
    "onCommand:extension.automatically.i18n.switchLanguage",
    "onCommand:extension.automatically.i18n.updateLocalLangPackage",
    "onCommand:extension.automatically.i18n.setting",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:html",
    "onLanguage:json",
    "onLanguage:yaml",
    "onLanguage:yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.automatically.i18n.scanChinese",
        "title": "扫描中文"
      },
      {
        "command": "extension.automatically.i18n.scanChineseBatch",
        "title": "批量扫描中文"
      },
      {
        "command": "extension.automatically.i18n.generateLanguagePackage",
        "title": "生成语言包"
      },
      {
        "command": "extension.automatically.i18n.switchLanguage",
        "title": "切换语言"
      },
      {
        "command": "extension.automatically.i18n.updateLocalLangPackage",
        "title": "刷新数据"
      },
      {
        "command": "extension.automatically.i18n.setting",
        "title": "设置"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|vue|html|json|yaml|yml)$/",
          "submenu": "automatically/submenus",
          "group": "navigation"
        }
      ],
      "automatically/submenus": [
        {
          "command": "extension.automatically.i18n.scanChinese",
          "group": "1_workspace@1"
        },
        {
          "command": "extension.automatically.i18n.scanChineseBatch",
          "group": "1_workspace@2"
        },
        {
          "command": "extension.automatically.i18n.generateLanguagePackage",
          "group": "2_workspace@1"
        },
        {
          "command": "extension.automatically.i18n.switchLanguage",
          "group": "2_workspace@2"
        },
        {
          "command": "extension.automatically.i18n.updateLocalLangPackage",
          "group": "3_workspace@1"
        },
        {
          "command": "extension.automatically.i18n.setting",
          "group": "4_workspace@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "automatically/submenus",
        "label": "i18n-automatically(国际化)"
      }
    ]
  },
  "scripts": {
    "lint": "eslint --fix .",
    "build": "node scripts/esbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:js": "vitest run tests/unit/jsProcessor.test.ts",
    "test:vue": "vitest run tests/unit/vueProcessor.test.ts",
    "test:unit": "vitest run",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.59.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.2",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vue/compiler-dom": "^3.5.8",
    "@vue/compiler-sfc": "^3.5.6",
    "axios": "^1.7.7",
    "json5": "^2.2.3",
    "prettier": "^3.3.3"
  }
}
